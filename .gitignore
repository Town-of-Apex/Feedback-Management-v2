# Operational data
# Live SQLite workshop/event database and its journal files.
# The empty data/ directory is kept via data/.gitkeep.
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Admin CSV exports (default download name from /admin/export)
feedback_responses*.csv
exports/

# Runtime tunnel artifacts
# qr.png and tunnel_url.txt embed EVENT_KEY. Do not commit them.
tunnel.log
*.log
logs/
app/static/tunnel_url.txt
app/static/qr.png

